# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# A Little Something For You ♡ — Date Booking & Multi-Channel Notifications (SMS + Email)
#
# IMPORTANT:
# - These variables are for SERVER-SIDE Vercel Functions ONLY.
# - NEVER prefix these with VITE_ or expose them to the client browser.
# - Copy this file to .env.local for local development.
# ==============================================================================

# MSG91 Flow API Configuration (SMS to Indian Mobile)
# Get your Auth Key from MSG91 Dashboard -> Authkey
MSG91_AUTH_KEY=your_msg91_authkey_here

# The MSG91 Flow / Campaign Template ID (Configured with VAR1, VAR2, VAR3, VAR4)
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Approved DLT Sender ID (Header) e.g. DTOUTE, HRISHI, etc.
MSG91_SENDER_ID=your_dlt_sender_id_here

# Your personal Indian mobile number to receive the booking SMS alert
# Example: 919876543210
MSG91_RECIPIENT_NUMBER=91XXXXXXXXXX

# Optional: Set to 'true' to simulate SMS dispatch locally without sending real SMS credits
MSG91_MOCK=false

# ==============================================================================
# Email Notification Configuration (Deliver date alerts to your Inbox)
# ==============================================================================
# Your personal email address where date confirmations will be sent
NOTIFICATION_EMAIL=kelengpranab4@gmail.com

# Sender email address displayed to recipient
NOTIFICATION_EMAIL_FROM="A Little Something For You <onboarding@resend.dev>"

# Provider Option 1: Resend API (Recommended & Easiest for Vercel)
# Get an API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Provider Option 2: SMTP / Gmail (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
SMTP_SECURE=true

# Set to 'true' to simulate email dispatch locally without sending real emails
EMAIL_MOCK=false

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase SERVICE ROLE secret key (NOT the anon public key!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Business Logic Rules
APP_TIMEZONE=Asia/Kolkata
DATE_MINIMUM=2026-11-21
